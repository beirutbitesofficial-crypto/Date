# App
NODE_ENV=production
REQUIRE_PRODUCTION_SERVICES=true
PORT=3000
APP_URL=https://your-domain.com
SESSION_SECRET=replace-with-at-least-32-random-characters

# Production database (PostgreSQL / Supabase Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true

# Cloud media storage (Supabase Storage)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=folio-media

# Google Drive Picker
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_API_KEY=AIza_REPLACE_ME
GOOGLE_APP_ID=000000000000

# Optional
TRUST_PROXY=1
MAX_UPLOAD_MB=250
